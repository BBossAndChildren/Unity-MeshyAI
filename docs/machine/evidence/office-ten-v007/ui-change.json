    "+                if(ch=='\\n'){b.Append(ch);col=0;continue;}",
    "+                int width=ch>255?2:1;if(col+width>columns){b.Append('\\n');col=0;}",
    "+                b.Append(ch);col+=width;",
    "+            }",
    "+            return b.ToString();",
    "+        }",
    "+        void UpdateMonitorDocument()",
